@prefix : <http://www.synecdoque.com/2025/afo-lis#> .
@prefix afo: <http://www.synecdoque.com/2025/afo#> .
@prefix lis: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lis-ext: <http://www.semanticweb.org/ARROWHEADfPVN/ontologies/ido-ext#> .
@base <http://www.synecdoque.com/2025/afo-lis#> .

<http://www.synecdoque.com/2025/afo-lis> rdf:type owl:Ontology ;
    owl:versionIRI <http://www.synecdoque.com/2025/afo-lis/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    rdfs:label "AFO to LIS-14 alignment" ;
    dcterms:title "Arrowhead Framework Ontology — LIS-14 alignment" ;
    dcterms:description "Aligns AFO's classes and properties onto the LIS-14 reference data library, so an Arrowhead local cloud can be read by tools that speak the upstream industrial vocabularies." ;
    dcterms:creator "Oskar Wintercorn" ;
    dcterms:publisher "Synecdoque" ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://doi.org/10.1109/OJIES.2026.3693084> .


#################################################################
#    Object Properties
#################################################################

###  http://www.synecdoque.com/2025/afo#hasHusk
afo:hasHusk rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf lis:hasFunctionalPart .


###  http://www.synecdoque.com/2025/afo#hasServer
afo:hasServer rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf lis:hasFunctionalPart .


###  http://www.synecdoque.com/2025/afo#hasUnitAsset
afo:hasUnitAsset rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf lis:hasFunctionalPart .


###  http://www.synecdoque.com/2025/afo#providesService
afo:providesService rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf lis:hasFunction .


###  http://www.synecdoque.com/2025/afo#runsOnHost
afo:runsOnHost rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf lis:containedBy .


###  http://www.synecdoque.com/2025/afo-lis#functionalLocationOf
afo:functionalLocationOf rdf:type owl:ObjectProperty ;
                      owl:inverseOf :hasFunctionalLocation .


###  http://www.synecdoque.com/2025/afo-lis#hasFunctionalLocation
afo:hasFunctionalLocation rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf lis-ext:implements ;
                       rdfs:domain afo:UnitAsset ;
                       rdfs:range :FunctionalLocation .


#################################################################
#    Classes
#################################################################

###  http://www.synecdoque.com/2025/afo#ConsumedService
afo:ConsumedService rdf:type owl:Class ;
                    rdfs:subClassOf lis:Function .


###  http://www.synecdoque.com/2025/afo#Host
afo:Host rdf:type owl:Class ;
         rdfs:subClassOf lis:FunctionalObject ,
                         lis:PhysicalArtefact .


###  http://www.synecdoque.com/2025/afo#Husk
afo:Husk rdf:type owl:Class ;
         rdfs:subClassOf lis:System .


###  http://www.synecdoque.com/2025/afo#LocalCloud
afo:LocalCloud rdf:type owl:Class ;
               rdfs:subClassOf lis:System .


###  http://www.synecdoque.com/2025/afo#Server
afo:Server rdf:type owl:Class ;
           rdfs:subClassOf lis:FunctionalObject .


###  http://www.synecdoque.com/2025/afo#Service
afo:Service rdf:type owl:Class ;
            rdfs:subClassOf lis:Function .


###  http://www.synecdoque.com/2025/afo#System
afo:System rdf:type owl:Class ;
           rdfs:subClassOf lis:System .


###  http://www.synecdoque.com/2025/afo#UnitAsset
afo:UnitAsset rdf:type owl:Class ;
              rdfs:subClassOf lis:FunctionalObject ,
                              lis:PhysicalObject .


###  http://www.synecdoque.com/2025/afo-lis#FunctionalLocation
afo:FunctionalLocation rdf:type owl:Class ;
                    rdfs:subClassOf lis-ext:FunctionalLocation .

