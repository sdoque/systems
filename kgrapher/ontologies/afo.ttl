@prefix :        <https://w3id.org/synecdoque/afo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@base            <https://w3id.org/synecdoque/afo#> .

<https://w3id.org/synecdoque/afo> rdf:type owl:Ontology ;
    owl:versionIRI   <https://w3id.org/synecdoque/afo/2.1.0> ;
    owl:priorVersion <https://w3id.org/synecdoque/afo/2.0.0> ;
    owl:versionInfo  "2.1.0" ;
    rdfs:label       "Arrowhead Framework Ontology" ;
    rdfs:comment     """Version 2.0.0 moves the ontology to a permanent identifier at w3id.org. Changing an ontology IRI changes its identity, which is why this is a major version and not a patch: every term minted under the previous namespace is a different term. It was done while nothing had adopted the vocabulary, when it costs nothing, and it is not a thing to do again.""" ;
    dcterms:title    "Arrowhead Framework Ontology (AFO)" ;
    dcterms:description "The Arrowhead Framework Ontology (AFO) provides a semantic model for Arrowhead local cloud architectures, including systems, services, hosts, and their relationships. It aims to enable semantic interoperability in industrial automation and cyber-physical systems." ;
    dcterms:creator  "Oskar Wintercorn" ;
    dcterms:publisher "Synecdoque" ;
    dcterms:license  <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-05"^^xsd:date ;
    rdfs:seeAlso     <https://doi.org/10.1109/OJIES.2026.3693084> ;
    dcterms:bibliographicCitation "O. Wintercorn and J. van Deventer, \"The Arrowhead Framework Ontology,\" IEEE Open Journal of the Industrial Electronics Society, 2026, doi: 10.1109/OJIES.2026.3693084." ;
    vann:preferredNamespacePrefix "afo" ;
    vann:preferredNamespaceUri    "https://w3id.org/synecdoque/afo#" .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/synecdoque/afo#communicatesOver
:communicatesOver rdf:type owl:ObjectProperty ;
                  owl:inverseOf :endpointOfHusk ;
                  rdfs:domain :Husk ;
                  rdfs:range :Endpoint ;
                  rdfs:label "communicates over" ;
                  rdfs:comment "Relates a Husk to the Endpoint through which it communicates." .


###  https://w3id.org/synecdoque/afo#consumes
:consumes rdf:type owl:ObjectProperty ;
          owl:inverseOf :provides ;
          rdfs:domain :ConsumedService ;
          rdfs:range :Service ;
          rdfs:label "consumes" ;
          rdfs:comment "Relates a ConsumedService to the Service it consumes." .


###  https://w3id.org/synecdoque/afo#consumesService
:consumesService rdf:type owl:ObjectProperty ;
                 owl:inverseOf :serviceConsumedBy ;
                 rdfs:domain :UnitAsset ;
                 rdfs:range :ConsumedService ;
                 rdfs:label "consumes service" ;
                 rdfs:comment "Relates a UnitAsset to a ConsumedService that it is consuming." .


###  https://w3id.org/synecdoque/afo#consumingFromSystem
:consumingFromSystem rdf:type owl:ObjectProperty ;
                     owl:inverseOf :providingToSystem ;
                     owl:propertyChainAxiom ( :hasUnitAsset
                                              :consumesService
                                              :consumes
                                              :serviceProvidedBy
                                              :isUnitAssetOf
                                            ) ;
                     rdfs:label "consuming from system" ;
                     rdfs:comment "Relates a System to another System from which it consumes a service. Derived via the property chain: hasUnitAsset ∘ consumesService ∘ consumes ∘ serviceProvidedBy ∘ isUnitAssetOf." .


###  https://w3id.org/synecdoque/afo#contains
:contains rdf:type owl:ObjectProperty ;
          owl:inverseOf :isContainedIn ;
          rdfs:domain :LocalCloud ;
          rdfs:range :System ;
          rdfs:label "contains" ;
          rdfs:comment "Relates a LocalCloud to a System it contains." .


###  https://w3id.org/synecdoque/afo#endpointOfHusk
:endpointOfHusk rdf:type owl:ObjectProperty ;
                rdfs:label "endpoint of husk" ;
                rdfs:comment "Relates an Endpoint to the Husk that communicates over it. Inverse of communicatesOver." .


###  https://w3id.org/synecdoque/afo#hasDeveloper
:hasDeveloper rdf:type owl:ObjectProperty ;
              rdfs:label "has developer" ;
              rdfs:comment "Relates a resource to its developer or development team." .


###  https://w3id.org/synecdoque/afo#hasHusk
:hasHusk rdf:type owl:ObjectProperty ;
         owl:inverseOf :isHuskOf ;
         rdfs:domain :System ;
         rdfs:range :Husk ;
         rdfs:label "has husk" ;
         rdfs:comment "Relates a System to its Husk, the runtime container responsible for communication and hosting." .


###  https://w3id.org/synecdoque/afo#hasServer
:hasServer rdf:type owl:ObjectProperty ;
           owl:inverseOf :isServerOf ;
           rdfs:domain :Husk ;
           rdfs:range :Server ;
           rdfs:label "has server" ;
           rdfs:comment "Relates a Husk to the Server it uses for handling HTTP/HTTPS requests." .


###  https://w3id.org/synecdoque/afo#hasUnitAsset
:hasUnitAsset rdf:type owl:ObjectProperty ;
              owl:inverseOf :isUnitAssetOf ;
              rdfs:domain :System ;
              rdfs:range :UnitAsset ;
              rdfs:label "has unit asset" ;
              rdfs:comment "Relates a System to its UnitAsset, the functional component that provides and consumes services." .


###  https://w3id.org/synecdoque/afo#hostingEndpoint
:hostingEndpoint rdf:type owl:ObjectProperty ;
                 owl:inverseOf :onHost ;
                 rdfs:label "hosting endpoint" ;
                 rdfs:comment "Relates a Host to an Endpoint it hosts. Inverse of onHost." .


###  https://w3id.org/synecdoque/afo#isContainedIn
:isContainedIn rdf:type owl:ObjectProperty ;
               rdfs:label "is contained in" ;
               rdfs:comment "Relates a System to the LocalCloud that contains it. Inverse of contains." .


###  https://w3id.org/synecdoque/afo#isHostOf
:isHostOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :runsOnHost ;
          rdfs:label "is host of" ;
          rdfs:comment "Relates a Host to a Husk that runs on it. Inverse of runsOnHost." .


###  https://w3id.org/synecdoque/afo#isHuskOf
:isHuskOf rdf:type owl:ObjectProperty ;
          rdfs:label "is husk of" ;
          rdfs:comment "Relates a Husk to the System it belongs to. Inverse of hasHusk." .


###  https://w3id.org/synecdoque/afo#isServerOf
:isServerOf rdf:type owl:ObjectProperty ;
            rdfs:label "is server of" ;
            rdfs:comment "Relates a Server to the Husk it belongs to. Inverse of hasServer." .


###  https://w3id.org/synecdoque/afo#isUnitAssetOf
:isUnitAssetOf rdf:type owl:ObjectProperty ;
               rdfs:label "is unit asset of" ;
               rdfs:comment "Relates a UnitAsset to the System it belongs to. Inverse of hasUnitAsset." .


###  https://w3id.org/synecdoque/afo#onHost
:onHost rdf:type owl:ObjectProperty ;
        rdfs:domain :Endpoint ;
        rdfs:range :Host ;
        rdfs:label "on host" ;
        rdfs:comment "Relates an Endpoint to the Host it is deployed on." .


###  https://w3id.org/synecdoque/afo#providesService
:provides rdf:type owl:ObjectProperty ;
        rdfs:domain :ProvidedService ;
        rdfs:range :ConsumedService ;
        rdfs:label "provides" ;
        rdfs:comment "provides" .

###  https://w3id.org/synecdoque/afo#providesService
:providesService rdf:type owl:ObjectProperty ;
                 owl:inverseOf :serviceProvidedBy ;
                 rdfs:domain :UnitAsset ;
                 rdfs:range :Service ;
                 rdfs:label "provides service" ;
                 rdfs:comment "Relates a UnitAsset to a Service it provides." .


###  https://w3id.org/synecdoque/afo#providingToSystem
:providingToSystem rdf:type owl:ObjectProperty ;
                   rdfs:label "providing to system" ;
                   rdfs:comment "Relates a System to another System it provides services to. Inverse of consumingFromSystem." .


###  https://w3id.org/synecdoque/afo#runsOnHost
:runsOnHost rdf:type owl:ObjectProperty ;
            rdfs:domain :Husk ;
            rdfs:range :Host ;
            rdfs:label "runs on host" ;
            rdfs:comment "Relates a Husk to the Host it runs on." .


###  https://w3id.org/synecdoque/afo#serviceConsumedBy
:serviceConsumedBy rdf:type owl:ObjectProperty ;
                   rdfs:label "service consumed by" ;
                   rdfs:comment "Relates a ConsumedService to the UnitAsset consuming it. Inverse of consumesService." .


###  https://w3id.org/synecdoque/afo#serviceProvidedBy
:serviceProvidedBy rdf:type owl:ObjectProperty ;
                   rdfs:label "service provided by" ;
                   rdfs:comment "Relates a Service to the UnitAsset providing it. Inverse of providesService." .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/synecdoque/afo#hasIPAddress
:hasIPAddress rdf:type owl:DatatypeProperty ;
              rdfs:domain :Host ;
              rdfs:range xsd:string ;
              rdfs:label "has IP address" ;
              rdfs:comment "The IP address of a Host." .


###  https://w3id.org/synecdoque/afo#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string ;
         rdfs:label "has name" ;
         rdfs:comment "The name of a resource, used for identification within the Arrowhead framework." .


###  https://w3id.org/synecdoque/afo#hasRegistrationPeriod
:hasRegistrationPeriod rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ProvidedService ;
                       rdfs:range xsd:nonNegativeInteger ;
                       rdfs:label "has registration period" ;
                       rdfs:comment "The period (in seconds) for which a ProvidedService is registered in the Service Registrar before requiring renewal." .


###  https://w3id.org/synecdoque/afo#hasServiceDefinition
:hasServiceDefinition rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ProvidedService ;
                      rdfs:range xsd:string ;
                      rdfs:label "has service definition" ;
                      rdfs:comment "The service definition identifier of a ProvidedService, used for discovery in the Arrowhead framework." .


###  https://w3id.org/synecdoque/afo#hasUrl
:hasUrl rdf:type owl:DatatypeProperty ;
        rdfs:domain :ProvidedService ;
        rdfs:range xsd:anyURI ;
        rdfs:label "has URL" ;
        rdfs:comment "The URL at which a ProvidedService is accessible." .


###  https://w3id.org/synecdoque/afo#isSubscribable
:isSubscribable rdf:type owl:DatatypeProperty ;
                rdfs:domain :ProvidedService ;
                rdfs:range xsd:boolean ;
                rdfs:label "is subscribable" ;
                rdfs:comment "Indicates whether a ProvidedService supports event-based subscriptions." .


###  https://w3id.org/synecdoque/afo#usesPort
:usesPort rdf:type owl:DatatypeProperty ;
          rdfs:domain :Endpoint ;
          rdfs:range xsd:nonNegativeInteger ;
          rdfs:label "uses port" ;
          rdfs:comment "The network port number used by an Endpoint." .


###  https://w3id.org/synecdoque/afo#usesProtocol
:usesProtocol rdf:type owl:DatatypeProperty ;
              rdfs:domain :Endpoint ;
              rdfs:range xsd:string ;
              rdfs:label "uses protocol" ;
              rdfs:comment "The communication protocol (e.g. HTTP, HTTPS) used by an Endpoint." .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/synecdoque/afo#CertificateAuthority
:CertificateAuthority rdf:type owl:Class ;
                      rdfs:subClassOf :System ;
                      rdfs:label "Certificate Authority" ;
                      rdfs:comment "A core Arrowhead System responsible for issuing and managing certificates that enable secure communication within a SecureLocalCloud." .


###  https://w3id.org/synecdoque/afo#ConsumedService
:ConsumedService rdf:type owl:Class ;
                 rdfs:subClassOf [ owl:intersectionOf ( :Service
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :serviceConsumedBy ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass :UnitAsset
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
                 owl:disjointWith :ProvidedService ;
                 rdfs:label "Consumed Service" ;
                 rdfs:comment "A Service that is consumed by at least one UnitAsset. Disjoint with ProvidedService." .


###  https://w3id.org/synecdoque/afo#Endpoint
:Endpoint rdf:type owl:Class ;
          rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                   owl:onProperty :usesPort ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:integer
                                                 ]
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :usesProtocol ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:string
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
          rdfs:label "Endpoint" ;
          rdfs:comment "A network endpoint defined by at least one port and one protocol, hosted on a Host. Used by a Husk to expose communication interfaces." .


###  https://w3id.org/synecdoque/afo#Host
:Host rdf:type owl:Class ;
      rdfs:label "Host" ;
      rdfs:comment "A physical or virtual machine that hosts Endpoints and runs Husks." .


###  https://w3id.org/synecdoque/afo#Husk
:Husk rdf:type owl:Class ;
      rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasServer ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :Server
                                             ]
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :runsOnHost ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :Host
                                             ]
                                           ) ;
                        rdf:type owl:Class
                      ] ;
      rdfs:label "Husk" ;
      rdfs:comment "The runtime container of an Arrowhead System in the mbaigo framework. A Husk manages communication by hosting Endpoints and running on a Host. It contains at least one Server and runs on at least one Host." .


###  https://w3id.org/synecdoque/afo#LocalCloud
:LocalCloud rdf:type owl:Class ;
            rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                     owl:onProperty :contains ;
                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass :Orchestrator
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :contains ;
                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass :ServiceRegistrar
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
            rdfs:label "Local Cloud" ;
            rdfs:comment "An Arrowhead local cloud: a set of Systems within a defined administrative domain. Must contain at least one Orchestrator and one ServiceRegistrar." .


###  https://w3id.org/synecdoque/afo#Orchestrator
:Orchestrator rdf:type owl:Class ;
              rdfs:subClassOf :System ;
              rdfs:label "Orchestrator" ;
              rdfs:comment "A core Arrowhead System responsible for service orchestration — matching service consumers to appropriate service providers within the local cloud." .


###  https://w3id.org/synecdoque/afo#ProvidedService
:ProvidedService rdf:type owl:Class ;
                 rdfs:subClassOf [ owl:intersectionOf ( :Service
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :serviceProvidedBy ;
                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass :UnitAsset
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
                 rdfs:label "Provided Service" ;
                 rdfs:comment "A Service that is provided by exactly one UnitAsset. Disjoint with ConsumedService." .


###  https://w3id.org/synecdoque/afo#ResilientLocalCloud
:ResilientLocalCloud rdf:type owl:Class ;
                     rdfs:subClassOf [ owl:intersectionOf ( :LocalCloud
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :contains ;
                                                              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                              owl:onClass :Orchestrator
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :contains ;
                                                              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                              owl:onClass :ServiceRegistrar
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                     rdfs:label "Resilient Local Cloud" ;
                     rdfs:comment "A LocalCloud with at least two Orchestrators and two ServiceRegistrars, providing fault tolerance through redundancy." .


###  https://w3id.org/synecdoque/afo#SecureLocalCloud
:SecureLocalCloud rdf:type owl:Class ;
                  rdfs:subClassOf [ owl:intersectionOf ( :LocalCloud
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :contains ;
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass :CertificateAuthority
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:label "Secure Local Cloud" ;
                  rdfs:comment "A LocalCloud that includes at least one CertificateAuthority, enabling certificate-based secure communication between Systems." .


###  https://w3id.org/synecdoque/afo#Server
:Server rdf:type owl:Class ;
        rdfs:label "Server" ;
        rdfs:comment "The HTTP/HTTPS server component within a Husk, responsible for handling incoming requests." .


###  https://w3id.org/synecdoque/afo#Service
:Service rdf:type owl:Class ;
         rdfs:label "Service" ;
         rdfs:comment "A service offered or consumed within the Arrowhead framework. The superclass of ProvidedService and ConsumedService." .


###  https://w3id.org/synecdoque/afo#ServiceRegistrar
:ServiceRegistrar rdf:type owl:Class ;
                  rdfs:subClassOf [ owl:intersectionOf ( :System
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasName ;
                                                           owl:hasValue "serviceregistrar"
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:label "Service Registrar" ;
                  rdfs:comment "A core Arrowhead System responsible for registering and discovering services within the local cloud. Identified by the system name 'serviceregistrar'." .


###  https://w3id.org/synecdoque/afo#System
:System rdf:type owl:Class ;
        rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasHusk ;
                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass :Husk
                                               ]
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasUnitAsset ;
                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass :UnitAsset
                                               ]
                                             ) ;
                          rdf:type owl:Class
                        ] ;
        rdfs:label "System" ;
        rdfs:comment "An Arrowhead System: the primary participant in a local cloud. Consists of at least one Husk (runtime container) and at least one UnitAsset (functional component)." .


###  https://w3id.org/synecdoque/afo#UnitAsset
:UnitAsset rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :providesService ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Service
                           ] ;
           rdfs:label "Unit Asset" ;
           rdfs:comment "The functional component of an Arrowhead System. A UnitAsset encapsulates the domain logic and must provide at least one Service. It may also consume services from other Systems." .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CertificateAuthority
                :Orchestrator
                :ServiceRegistrar
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Endpoint
                :Host
                :Husk
                :LocalCloud
                :Server
                :Service
                :System
                :UnitAsset
              )
] .


###  Generated by the OWL API (version 4.5.26.2023-07-17T20:34:13Z) https://github.com/owlcs/owlapi


#################################################################
#    Added in 1.2.0 — terms the runtime already emits
#################################################################
#
# These twelve predicates and two classes were written into every graph the
# framework produced while the ontology declared none of them: a consumer who
# dereferenced afo: to find out what they meant found nothing. Declaring them
# is what makes the emitted graph and the vocabulary agree.

###  Mission — what a unit asset is for
:hasMission rdf:type owl:DatatypeProperty ;
    rdfs:domain :UnitAsset ;
    rdfs:range xsd:string ;
    rdfs:label "has mission" ;
    rdfs:comment "The purpose an asset serves: measurement, actuation, state, control, aggregation, core or logging. It is what an authorizer reasons about, and what lets a consumer tell a sensor from an actuator." .

###  Functional location — where an asset is, functionally
:FunctionalLocation rdf:type owl:Class ;
    rdfs:label "functional location" ;
    rdfs:comment "A place an asset serves, named by the deployment: a room, a vehicle, a plant designation. Aligned to upstream vocabularies by the AFO-IDO, DEXPI, STEP and LBD alignment ontologies." .

:hasFunctionalLocation rdf:type owl:ObjectProperty ;
    rdfs:domain :UnitAsset ;
    rdfs:range :FunctionalLocation ;
    rdfs:label "has functional location" ;
    rdfs:comment "Promoted from the alignment ontologies, where it was declared because the bridges depend on it and the authorizer matches policy on it." .

###  Where a service is bound
:hostedOnEndpoint rdf:type owl:ObjectProperty ;
    rdfs:domain :Service ;
    rdfs:range :Endpoint ;
    rdfs:label "hosted on endpoint" ;
    rdfs:comment "The endpoint a service answers on." .

#################################################################
#    Security posture
#################################################################
#
# A system's posture is a resource of its own so that it can be queried: what
# a cloud actually enforces, rather than what its configuration intended.

:SecurityPosture rdf:type owl:Class ;
    rdfs:label "security posture" ;
    rdfs:comment "The security a system actually presents at run time: whether it is identified, what it will accept, and whom it trusts to say so." .

:hasSecurityPosture rdf:type owl:ObjectProperty ;
    rdfs:domain :System ;
    rdfs:range :SecurityPosture ;
    rdfs:label "has security posture" .

:hasSecurityLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ;
    rdfs:range xsd:string ;
    rdfs:label "has security level" ;
    rdfs:comment "A summary of the posture below, for a reader who wants one word rather than seven booleans." .

:namesCertificateAuthority rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "names certificate authority" ;
    rdfs:comment "Whether the system's configuration names a CA to enroll with. A system that names none can hold no certificate." .

:namesAuthorizer rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "names authorizer" ;
    rdfs:comment "Whether an authorizer is named. Naming one is what turns enforcement on, so this reports a decision, not a capability." .

:isIdentified rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "is identified" ;
    rdfs:comment "Whether the system holds a certificate and can prove who it is." .

:canVerifyPeers rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "can verify peers" ;
    rdfs:comment "Whether it holds the trust root needed to check a peer's certificate." .

:verifiesTokens rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "verifies tokens" ;
    rdfs:comment "Whether it holds the authorizer's public key and so can check an access token it is given." .

:offersTLS rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "offers TLS" ;
    rdfs:comment "Whether an HTTPS endpoint is bound." .

:acceptsPlaintext rdf:type owl:DatatypeProperty ;
    rdfs:domain :SecurityPosture ; rdfs:range xsd:boolean ;
    rdfs:label "accepts plaintext" ;
    rdfs:comment "Whether the system still answers on its plaintext port. True alongside offersTLS is the ordinary state during enrollment, and a finding afterwards." .


#################################################################
#    Added in 2.1.0 — terms promoted from the local namespace
#################################################################
#
# Four terms the framework has always written, under a namespace that means
# nothing to a reader who dereferences it. None of them is deployment-specific:
# every Arrowhead service in every cloud has a mode, and a service that carries
# a measurement has a unit and a quantity kind. They were minted locally only
# because the ontology had not declared them.

###  How a service is used
:Mode rdf:type owl:Class ;
    rdfs:label "mode" ;
    rdfs:comment """How a service is used: read a value, write one, or invoke an
operation. The authorizer maps a mode to the action a policy grants, so this is
a term access control depends on — which is the argument for declaring it here
rather than leaving it in a namespace nothing can interpret.""" .

:Get rdf:type :Mode ; rdfs:label "get" ; rdfs:comment "Read the current value." .
:Set rdf:type :Mode ; rdfs:label "set" ; rdfs:comment "Write a value." .
:Do  rdf:type :Mode ; rdfs:label "do"  ; rdfs:comment "Invoke an operation." .

:Mode owl:equivalentClass [ rdf:type owl:Class ; owl:oneOf ( :Get :Set :Do ) ] .

:hasMode rdf:type owl:ObjectProperty ;
    rdfs:domain :Service ;
    rdfs:range :Mode ;
    rdfs:label "has mode" ;
    rdfs:comment """Declared on Service rather than on ConsumedService, which is
the only kind that carries it today: a provided service has a mode too, and a
domain that excluded it would have to be widened later, which is the change this
version exists to avoid making twice.""" .

###  Units and quantity kinds, aligned to QUDT
#
# QUDT declares no domain on either property, only a range, so a sub-property
# here inherits nothing unwanted about the subject — it says where the term
# applies, which QUDT does not, and keeps the meaning QUDT gives it. The range
# comes with the alignment: an object of afo:hasUnit is a qudt:Unit, which makes
# a locally minted "unit" a detectable error rather than a silent one.

:hasUnit rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf qudt:hasUnit ;
    rdfs:domain :Service ;
    rdfs:label "has unit" ;
    rdfs:comment "The unit a service's values are expressed in, as a QUDT unit." .

:hasQuantityKind rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf qudt:hasQuantityKind ;
    rdfs:domain :Service ;
    rdfs:label "has quantity kind" ;
    rdfs:comment "What is being measured, as a QUDT quantity kind: temperature, angle, time." .
