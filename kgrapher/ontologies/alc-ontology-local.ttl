@prefix alc:     <http://www.synecdoque.com/lcloud/> .
@prefix afo:     <https://w3id.org/synecdoque/afo#> .
@prefix bot:     <https://w3id.org/bot#> .
@prefix cloud:   <http://www.synecdoque.com/lcloud/AlphaCloud/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<http://www.synecdoque.com/lcloud/> rdf:type owl:Ontology ;
    owl:versionInfo "0.2.0" ;
    dcterms:creator "Oskar Wintercorn" ;
    dcterms:publisher "Synecdoque" ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    rdfs:label "Local Cloud Ontology (example)" ;
    dcterms:modified "2026-09-05"^^xsd:date ;
    rdfs:comment """The vocabulary a local cloud mints for itself, and an example of what belongs in it.

The Arrowhead Framework Ontology (AFO) describes what every local cloud has in common: systems, husks, hosts, services, endpoints. It is another project's work, versioned and cited independently, and a term written into its namespace but absent from it is one no reasoner can interpret and its shapes cannot validate. Everything a particular cloud knows that AFO does not is therefore minted here instead.

What that leaves is smaller than it was. The detail keys an operator writes in systemconfig.json used to land here — hasUnit, hasQuantityKind, hasMode, hasForms, hasMethods, fromUrl — and AFO 2.1.0 and 2.2.0 declared all of them, because a unit and a payload format are what the framework defines rather than what a site does. A display name went the other way and became rdfs:label, since a label is a term the world already has. Nothing is left in this namespace that describes the framework.

What remains is the more interesting half: what the cloud is deployed *into*. The building, its rooms, and which room an asset acts in. That is not framework vocabulary at all, and it is where the cloud graph meets the building graph.

Version 0.2.0 changes how that half is modelled, from OWL classes to SKOS concepts. A room's function is not a crisp fact — a kitchen-diner is one space doing two jobs — and OWL's value is in axioms, of which the tempting one here, that Kitchen and DiningRoom are disjoint, is false in half the houses this would be deployed in. A designation system is what this is, and SKOS is what designation systems are written in: it carries notations, labels in any language, and matches to other schemes, and asks for no commitment nobody can honour. RDS-PP and KKS, the German plant designation systems, would be a second concept scheme beside this one.

This file is an example rather than a specification. The concept scheme below travels; the topology under it is one cottage's and is meant to be replaced.""" ;
    rdfs:seeAlso <https://w3id.org/bot#> ;
    rdfs:seeAlso <http://www.w3.org/2004/02/skos/core#> ;
    rdfs:seeAlso <https://doi.org/10.1109/OJIES.2026.3693084> .


#################################################################
#    1. The place vocabulary — shared, and reusable as it stands
#################################################################
#
# Concepts, not classes. Every cloud's kitchen is this kitchen: that sharing is
# correct because a concept is a kind of place and not a place. Two clouds that
# both said alc:Kitchen of their own rooms were saying the rooms were the same.

alc:DwellingPlaces rdf:type skos:ConceptScheme ;
    dcterms:title "Places in a dwelling"@en ;
    rdfs:comment """The kinds of place a domestic local cloud refers to. Names
here are labels and not identifiers, which is the point: a label may carry
spaces, parentheses and any language, and an identifier may not. A location
written as free text became either a name or a quoted string depending on
whether it happened to contain a space.""" .

alc:Place rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ;
    skos:topConceptOf alc:DwellingPlaces ;
    skos:prefLabel "place"@en , "plats"@sv .

alc:Indoor rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Place ;
    skos:prefLabel "indoor"@en , "inomhus"@sv .

alc:Outdoor rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Place ;
    skos:prefLabel "outdoor"@en , "utomhus"@sv .

alc:Room rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Indoor ;
    skos:prefLabel "room"@en , "rum"@sv .

alc:Kitchen rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Room ;
    skos:prefLabel "kitchen"@en , "kök"@sv ;
    skos:related alc:DiningRoom .

alc:DiningRoom rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Room ;
    skos:prefLabel "dining room"@en , "matsal"@sv ;
    skos:altLabel "Diningroom"@en .   # the spelling the configuration files use

alc:LivingRoom rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Room ;
    skos:prefLabel "living room"@en , "vardagsrum"@sv ;
    skos:related alc:DiningRoom .

alc:Bathroom rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Room ;
    skos:prefLabel "bathroom"@en , "badrum"@sv .

alc:Entrance rdf:type skos:Concept ;
    skos:inScheme alc:DwellingPlaces ; skos:broader alc:Indoor ;
    skos:prefLabel "entrance"@en , "entré"@sv .


#################################################################
#    2. This deployment's topology — replace this
#################################################################
#
# The concepts above are shared; the places below belong to one cottage, which
# is why they are minted under the cloud's own name rather than beside the
# vocabulary. A second deployment replaces this section entirely and keeps
# everything above it.
#
# The site is not a classification. "Kälkholmen (Indoor)" was one string doing
# two jobs — naming where the cottage is, and saying a sensor is inside it —
# which is why it could serve as neither an identifier nor a label.

cloud:Kalkholmen rdf:type bot:Site ;
    rdfs:label "Kälkholmen"@sv .

cloud:Cottage rdf:type bot:Building ;
    rdfs:label "the cottage"@en , "stugan"@sv .

cloud:Kalkholmen bot:hasBuilding cloud:Cottage .

cloud:KitchenSpace rdf:type bot:Space ;
    rdfs:label "kitchen"@en ;
    dcterms:subject alc:Kitchen , alc:Indoor .

cloud:DiningroomSpace rdf:type bot:Space ;
    rdfs:label "dining room"@en ;
    dcterms:subject alc:DiningRoom , alc:Indoor .

cloud:BathroomSpace rdf:type bot:Space ;
    rdfs:label "bathroom"@en ;
    dcterms:subject alc:Bathroom , alc:Indoor .

cloud:Outside rdf:type bot:Space ;
    rdfs:label "outside"@en ;
    dcterms:subject alc:Outdoor .

cloud:Cottage bot:hasSpace
    cloud:KitchenSpace , cloud:DiningroomSpace , cloud:BathroomSpace .


#################################################################
#    3. How a system reaches these places
#################################################################
#
# Nothing about the runtime changes: afo:hasFunctionalLocation still names a
# place. What changes is that the place is an identifier with a description
# behind it, rather than a word whose form depended on its punctuation.
#
#   alc:AlphaCloud_home_ethermostat_BathroomHeater
#       afo:hasFunctionalLocation cloud:BathroomSpace .
#   alc:AlphaCloud_home_meteorologue_IndoorModule2
#       afo:hasFunctionalLocation cloud:BathroomSpace .
#
# Those two are the heater and the sensor that were alc:Bathroom and the string
# "Bathroom " — with a trailing space, so the same room twice and joinable by
# nothing. Here they are one place, and asking what is in the bathroom answers
# with both.
#
# The outdoor and wind modules belong at cloud:Outside. They said
# "Kälkholmen (Indoor)", which was wrong twice: they are not indoors, and a
# site is not a room.


#################################################################
#    4. Where a building model joins
#################################################################
#
# One statement for each room the IFC model also knows:
#
#   cloud:BathroomSpace owl:sameAs <https://www.sml-dt.se/cottage/Space_2Nf7k> .
#
# Better, once a deployment can name IFC identities directly: the space above is
# never minted and the IFC IRI is used from the start, at which point there is
# no join to state because there is only one subject.
